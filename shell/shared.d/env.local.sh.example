#!/usr/bin/env bash
# ======================================================================
# 文件：env.local.sh.example
# 作用：提供本机私有环境变量与缓存路径的可提交模板。
# 使用方式：复制为 env.local.sh 后，由 shared.d loader source；真实文件被 gitignore。
# ======================================================================

# -- file locations -----------------------------------------------------
# 真实文件位于 shell/shared.d/env.local.sh，通常由 deploy.sh 建立 symlink。
# zsh/bash 从 ~/.bashrc.d/*.sh 加载；pwsh profile 解析相同的 export 行。
# 用法：cp shell/shared.d/env.local.sh.example shell/shared.d/env.local.sh，然后执行 ./shell/deploy.sh。

# -- API keys -----------------------------------------------------------
# 仅放本机密钥占位符，不提交真实值。
export XH_API_KEY='sk-REPLACE_ME'
export LOCAL_API_KEY='sk-REPLACE_ME'
export GLM_CODING_PLAN_API_KEY='REPLACE_ME'
export CONTEXT7_API_KEY='ctx7sk-REPLACE_ME'

# -- Hermes -------------------------------------------------------------
# 程序本体仍在官方安装目录；配置与状态放数据盘。
export HERMES_HOME="/Volumes/Data/agents/hermes"

# -- Rust cache ---------------------------------------------------------
# 缓存目录放数据盘；不要全局设置 CARGO_TARGET_DIR，避免多项目互相踩 target。
# 日常默认保留 incremental；需要提高 sccache 命中率时可单次设置 CARGO_INCREMENTAL=0。
if [ -d "/Volumes/Data" ]; then
    export SCCACHE_DIR="/Volumes/Data/cache/sccache"
    export CARGO_HOME="/Volumes/Data/cache/cargo"
    # export RUSTUP_HOME="/Volumes/Data/cache/rustup"
    mkdir -p "$SCCACHE_DIR" "$CARGO_HOME" 2>/dev/null || true
fi

# 需要已安装 sccache；否则请注释此变量，避免 cargo 因 wrapper 缺失失败。
export RUSTC_WRAPPER="sccache"

# -- optional mode ------------------------------------------------------
# export CARGO_INCREMENTAL=0

# -- aliases ------------------------------------------------------------
# alias skill-add-personal='npx skills add http://macmini:30001/mudssky/agent-skills.git'
# 单次强制走 sccache 友好模式：
# alias cargo-cold='CARGO_INCREMENTAL=0 cargo'
