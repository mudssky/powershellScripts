# 文件：99-k8s.zsh
# 作用：在交互式 Zsh 中加载 kubectl 补全。
# 兼容性：仅 Zsh 交互式 shell。
# ======================================================================

# -- kubectl completion -------------------------------------------------
if command -v kubectl &> /dev/null; then
  source <(kubectl completion zsh)
fi
